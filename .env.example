# Postgres (local docker compose; use the Neon URL for the deployed demo)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gateway

# Local model: any OpenAI-compatible server (vLLM on Modal, or Ollama for dev)
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=none
LLAMA_MODEL=llama3.1:8b

# Closed model: Muse Spark via the Meta Model API (OpenAI-compatible endpoint)
MUSE_BASE_URL=https://api.llama.com/compat/v1
MUSE_API_KEY=
MUSE_MODEL=muse-spark
# USD per 1M tokens. Fill in from Meta's pricing page.
MUSE_INPUT_PRICE_PER_M=0
MUSE_OUTPUT_PRICE_PER_M=0

# Hard cap on total Muse spend, in USD
SPEND_CAP_USD=150
