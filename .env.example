# Copy to .env. LOCAL runs everything on this machine; switch to CLOUD when the Modal
# and Meta keys arrive. Only this file changes.
#
# Local setup:
#   docker compose up -d && uv run python scripts/init_db.py
#   OLLAMA_CONTEXT_LENGTH=16384 OLLAMA_MAX_LOADED_MODELS=2 ollama serve
#   ollama pull llama3.2:3b && ollama pull llama3.1:8b
#   uv run python scripts/add_key.py --team web --user me --admin

# ---------- LOCAL (default) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gateway

# Gateway model: Ollama stands in for vLLM on Modal
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=none
LLAMA_MODEL=llama3.2:3b
LLAMA_BACKEND=ollama

# "Muse": a larger open model on Ollama stands in for Muse Spark.
# Placeholder prices so the ledger and spend cap run the real code path.
MUSE_BASE_URL=http://localhost:11434/v1
MUSE_API_KEY=
MUSE_MODEL=llama3.1:8b
MUSE_INPUT_PRICE_PER_M=1.0
MUSE_OUTPUT_PRICE_PER_M=4.0
MUSE_IS_STANDIN=true

# Hard cap on total Muse spend, in USD
SPEND_CAP_USD=150

# Compression calls in flight while ingesting. 1 = one page at a time (the original plan);
# 16 lets vLLM batch them. scripts/ingest_check.sh checks the two agree before a full run.
INGEST_CONCURRENCY=1

# The gate saved by eval/learn_gate.py (scripts/gate_run.sh). Empty: the rule-based gate.
# GATE_PATH=eval/results/gate_full1_model.json
# The cascade's threshold on P(draft right), instead of the saved one (learn_gate prints one per
# budget; higher escalates more). Full run: 0.46 = code at 10% of muse_direct's tokens, 0.72 = 20%.
# GATE_THRESHOLD=0.72
# Muse's reasoning effort for requests that don't set one (scripts/effort_run.sh). Empty: default.
# MUSE_REASONING_EFFORT=minimal

# ---------- SIM (checking the code, no GPU: see eval/sim.py and scripts/sim_full.sh) ----------
# uv run python -m eval.sim --port 8099, then:
# LLAMA_BASE_URL=http://localhost:8099/v1
# LLAMA_MODEL=sim-weak
# LLAMA_BACKEND=vllm
# MUSE_BASE_URL=http://localhost:8099/v1
# MUSE_MODEL=sim-strong
#
# Optional for any experiment: replay identical model calls from a local cache.
# MODEL_CACHE=eval/data/model_cache.sqlite

# ---------- CLOUD (uncomment when keys arrive, delete the LOCAL values above) ----------
# Checklist: confirm Muse base URL, model id and prices on Meta's docs; size the eval
# (items x ~14K tokens x price ~= $100); `modal deploy modal_app.py`; rerun scripts/hello.py.
# Evals run on this machine, so the local DATABASE_URL stays; Neon is only for the demo.
#
# DATABASE_URL=postgresql://...neon.tech/gateway?sslmode=require
# LLAMA_BASE_URL=https://<workspace>--memory-gateway-llama-serve[.<region>].modal.run/v1   # as printed by modal deploy
# LLAMA_API_KEY=<same value as the Modal secret llama-api-key>
# LLAMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLAMA_BACKEND=vllm
# MUSE_BASE_URL=<OpenAI-compatible base URL from the Meta developer console, ending in /v1>
# MUSE_API_KEY=
# MUSE_MODEL=<model id from the console, e.g. muse-spark-1.1>
# MUSE_INPUT_PRICE_PER_M=
# MUSE_OUTPUT_PRICE_PER_M=
# MUSE_IS_STANDIN=false
